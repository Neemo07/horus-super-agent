{
  "$schema": "https://opencode.ai/config.json",
  // Horus Super Agent v0.7.5 — DAG-Wave Orchestrator + Vibe Playbook + Graphify + Horus Context Mode + Native OpenCode Poll UI
  "default_agent": "horus",
  "instructions": [
    "AGENTS.md"
  ],
  "permissions": [
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "subagent", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    // Horus Context Mode (SQLite FTS5 + sandboxed ctx_execute; requires Node.js >= 22.5.0)
    "horus-context-mode": {
      "type": "local",
      "command": ["node", ".opencode/context-mode/server.js"],
      "enabled": true
    }
    // Optional MCP servers: keep graphify CLI-first by default when ai-memory is active; uncomment only for massive repos
    // ,
    // "graphify": {
    //   "type": "local",
    //   "command": ["graphify-mcp", "graphify-out/graph.json"],
    //   "enabled": true
    // },
    // "rea": {
    //   "type": "local",
    //   "command": ["npx", "-y", "rea-agents@latest", "mcp"],
    //   "enabled": true
    // }
  }
}
